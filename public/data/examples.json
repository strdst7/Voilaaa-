[
  {
    "title": "Quantum Wave Functions",
    "url": "https://www.youtube.com/watch?v=Usu9xZfabPM",
    "spec": "Create an interactive simulation of a 1D quantum wave function in a potential well.\n\nSPECIFICATIONS:\n1. The app should display a 1D potential well (infinite square well or harmonic oscillator).\n2. The user should be able to select the energy state (n=1, 2, 3, etc.).\n3. The app should visualize the probability density function |ψ(x)|² and the wave function ψ(x).\n4. The user should be able to adjust the width of the well.\n5. The simulation should show the time evolution of the wave function phase.\n6. Include an explanation of the Schrödinger equation components.",
    "code": "<!DOCTYPE html><html lang='en'><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width, initial-scale=1.0'><title>Quantum Wave Explorer</title><style>body { font-family: sans-serif; display: flex; flex-direction: column; align-items: center; padding: 20px; background: #1a1a1a; color: white; } canvas { border: 1px solid #444; background: #000; margin-top: 20px; } .controls { display: flex; gap: 20px; margin-bottom: 10px; } .info { max-width: 600px; text-align: center; margin-top: 20px; color: #aaa; }</style></head><body><h1>Quantum Wave Function Explorer</h1><div class='controls'><div><label>Energy Level (n): </label><input type='number' id='nValue' value='1' min='1' max='10'></div><div><label>Well Width: </label><input type='range' id='widthRange' min='50' max='300' value='200'></div></div><canvas id='quantumCanvas' width='600' height='400'></canvas><div class='info'><p>This simulation shows the stationary states of a particle in an infinite square well. The blue line is the probability density, and the faint green wave is the real part of the wave function.</p></div><script>const canvas = document.getElementById('quantumCanvas'); const ctx = canvas.getContext('2d'); const nInput = document.getElementById('nValue'); const widthInput = document.getElementById('widthRange'); let time = 0; function draw() { ctx.clearRect(0, 0, canvas.width, canvas.height); const L = parseInt(widthInput.value); const n = parseInt(nInput.value); const startX = (canvas.width - L) / 2; ctx.strokeStyle = '#fff'; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(startX, 50); ctx.lineTo(startX, 350); ctx.lineTo(startX + L, 350); ctx.lineTo(startX + L, 50); ctx.stroke(); ctx.beginPath(); ctx.strokeStyle = '#4A90E2'; ctx.lineWidth = 3; for(let x = 0; x <= L; x++) { const psi = Math.sqrt(2/L) * Math.sin(n * Math.PI * x / L); const prob = psi * psi * 4000; const canvasX = startX + x; const canvasY = 350 - prob; if(x === 0) ctx.moveTo(canvasX, canvasY); else ctx.lineTo(canvasX, canvasY); } ctx.stroke(); ctx.beginPath(); ctx.strokeStyle = 'rgba(0, 255, 0, 0.3)'; ctx.lineWidth = 1; for(let x = 0; x <= L; x++) { const psi = Math.sqrt(2/L) * Math.sin(n * Math.PI * x / L); const phase = Math.cos(time * 0.1); const canvasX = startX + x; const canvasY = 200 - (psi * 150 * phase); if(x === 0) ctx.moveTo(canvasX, canvasY); else ctx.lineTo(canvasX, canvasY); } ctx.stroke(); time++; requestAnimationFrame(draw); } draw();</script></body></html>"
  },
  {
    "title": "Sorting Algorithms",
    "url": "https://www.youtube.com/watch?v=kPRA0W1kECg",
    "spec": "Create an interactive sorting algorithm visualizer.\n\nSPECIFICATIONS:\n1. Visualize Bubble Sort, Insertion Sort, and Selection Sort.\n2. Allow the user to randomize the array.\n3. Allow the user to adjust the sorting speed.\n4. Highlight the elements being compared and swapped.\n5. Show a completion animation when the array is sorted.",
    "code": "<!DOCTYPE html><html lang='en'><head><meta charset='UTF-8'><title>Sorting Visualizer</title><style>body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; display: flex; flex-direction: column; align-items: center; background: #f0f2f5; } #container { display: flex; align-items: flex-end; height: 300px; gap: 2px; padding: 20px; border-bottom: 2px solid #333; } .bar { background: #3498db; width: 10px; transition: height 0.1s; } .controls { margin-top: 20px; display: flex; gap: 10px; }</style></head><body><h1>Sorting Visualizer</h1><div id='container'></div><div class='controls'><button onclick='resetArray()'>Randomize</button><button onclick='bubbleSort()'>Bubble Sort</button><button onclick='selectionSort()'>Selection Sort</button></div><script>const container = document.getElementById('container'); let array = []; const size = 40; function resetArray() { array = []; container.innerHTML = ''; for(let i=0; i<size; i++) { const val = Math.floor(Math.random() * 250) + 10; array.push(val); const bar = document.createElement('div'); bar.className = 'bar'; bar.style.height = `${val}px`; bar.id = `bar-${i}`; container.appendChild(bar); } } async function bubbleSort() { for(let i=0; i<size; i++) { for(let j=0; j<size-i-1; j++) { const bar1 = document.getElementById(`bar-${j}`); const bar2 = document.getElementById(`bar-${j+1}`); bar1.style.background = '#e74c3c'; bar2.style.background = '#e74c3c'; await new Promise(r => setTimeout(r, 20)); if(array[j] > array[j+1]) { [array[j], array[j+1]] = [array[j+1], array[j]]; bar1.style.height = `${array[j]}px`; bar2.style.height = `${array[j+1]}px`; } bar1.style.background = '#3498db'; bar2.style.background = '#3498db'; } } } resetArray();</script></body></html>"
  },
  {
    "title": "Roman Empire Expansion",
    "url": "https://www.youtube.com/watch?v=6vMLT1aV-uE",
    "spec": "Create a map-based interactive showing the growth and decline of the Roman Empire.\n\nSPECIFICATIONS:\n1. Display a map of Europe and the Mediterranean.\n2. Use a time slider ranging from 753 BC to 1453 AD.\n3. Highlight the territory controlled by Rome at different intervals.\n4. Include markers for key battles and historical events.",
    "code": "<!DOCTYPE html><html><head><title>Roman Empire Timeline</title><style>body { font-family: Georgia, serif; background: #f4ece1; text-align: center; } #map-area { width: 80%; height: 400px; margin: 20px auto; background: #dcd0c0; border: 4px double #8b4513; display: flex; align-items: center; justify-content: center; } .event-desc { max-width: 700px; margin: auto; padding: 20px; font-style: italic; }</style></head><body><h1>Decline and Fall: The Roman Empire</h1><input type='range' id='yearSlider' min='-753' max='1453' value='-753' style='width: 80%;'><h2 id='yearDisplay'>753 BC</h2><div id='map-area'><svg width='500' height='300' viewBox='0 0 500 300'><circle id='empireRange' cx='250' cy='150' r='10' fill='rgba(255,0,0,0.3)' stroke='red' /></svg></div><div class='event-desc' id='eventText'>Rome is founded as a small kingdom.</div><script>const slider = document.getElementById('yearSlider'); const display = document.getElementById('yearDisplay'); const range = document.getElementById('empireRange'); const text = document.getElementById('eventText'); slider.oninput = function() { const year = parseInt(this.value); display.innerText = year < 0 ? `${Math.abs(year)} BC` : `${year} AD`; if(year < -500) { range.setAttribute('r', 10); text.innerText = 'Early City-State'; } else if(year < 0) { range.setAttribute('r', 50); text.innerText = 'Republican expansion across Italy.'; } else if(year < 200) { range.setAttribute('r', 150); text.innerText = 'Pax Romana: Peak of the Empire.'; } else { range.setAttribute('r', 40); text.innerText = 'Fragmentation and eventual collapse.'; } };</script></body></html>"
  },
  {
    "title": "Photosynthesis Flow",
    "url": "https://www.youtube.com/watch?v=sQK3Yr4Sc_k",
    "spec": "An interactive diagram of the photosynthesis process.\n\nSPECIFICATIONS:\n1. Show a leaf cross-section.\n2. Allow the user to 'add' Sunlight, Water, and CO2.\n3. Visualize the Light Reactions and the Calvin Cycle.\n4. Show the production of Glucose and Oxygen.\n5. Include an interactive quiz to test knowledge of inputs and outputs.",
    "code": "<!DOCTYPE html><html><head><title>Photosynthesis Interactive</title><style>body { font-family: sans-serif; text-align: center; background: #e8f5e9; } .leaf { width: 300px; height: 150px; background: #4caf50; border-radius: 100px 0 100px 0; margin: 50px auto; position: relative; border: 2px solid #2e7d32; } .particle { position: absolute; width: 10px; height: 10px; border-radius: 50%; opacity: 0; transition: all 1s; }</style></head><body><h1>Photosynthesis Lab</h1><button onclick='addInput(\"sun\")'>Add Sunlight</button><button onclick='addInput(\"water\")'>Add Water</button><button onclick='addInput(\"co2\")'>Add CO2</button><div class='leaf' id='leaf'></div><div id='output'>Add inputs to generate energy!</div><script>let inputs = {sun: false, water: false, co2: false}; function addInput(type) { inputs[type] = true; if(inputs.sun && inputs.water && inputs.co2) { document.getElementById('output').innerText = 'SUCCESS! Producing Glucose and Oxygen.'; document.getElementById('leaf').style.backgroundColor = '#81c784'; } else { document.getElementById('output').innerText = 'More inputs needed...'; } }</script></body></html>"
