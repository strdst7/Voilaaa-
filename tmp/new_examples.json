[
  {
    "title": "The Human Immune System",
    "url": "https://www.youtube.com/watch?v=zQGOcOUBi6s",
    "spec": "Build an interactive immune system simulator. \n\nSPECIFICATIONS:\n1. The app should show a 'Battlefield' (the human body) where bacteria or viruses start invading.\n2. The user can deploy 'Defenders' (Macrophages, Neutrophils, Natural Killer Cells) to fight them.\n3. Each defender type should have unique traits: Macrophages are slow but swallow multiple enemies; Neutrophils are fast but 'implode' after a few kills; Natural Killer cells target specifically infected cells.\n4. Show a 'Cytokine' meter that fills up as the battle progresses, allowing the user to call in 'Heavy Support' (Complement system or Dendritic cells calling for T-cells).\n5. The goal is to clear the infection before it overwhelms the body's 'Health Bar'.\n6. Include brief educational pop-ups explaining the role of each cell type as they are first used.",
    "code": "<!DOCTYPE html>\n<html>\n<head>\n<style>\n  body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #1a1a1a; color: white; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; margin: 0; overflow: hidden; }\n  #game-container { position: relative; width: 800px; height: 600px; background: #2c0a0a; border: 4px solid #4a1a1a; border-radius: 12px; cursor: crosshair; }\n  .cell { position: absolute; border-radius: 50%; transition: transform 0.1s linear; transform: translate(-50%, -50%); }\n  .bacteria { width: 12px; height: 12px; background: #4ecdc4; border: 2px solid #45b7af; }\n  .macrophage { width: 40px; height: 40px; background: #ff6b6b; border: 3px solid #ff5252; }\n  .neutrophil { width: 20px; height: 20px; background: #ffe66d; border: 2px solid #ffd93d; }\n  #sidebar { width: 800px; padding: 10px; display: flex; justify-content: space-around; background: #222; }\n  .btn { padding: 10px 20px; background: #444; border: none; color: white; border-radius: 5px; cursor: pointer; }\n  .btn:hover { background: #666; }\n  #stats { margin-top: 10px; font-size: 1.2rem; }\n  #overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: none; flex-direction: column; align-items: center; justify-content: center; background: rgba(0,0,0,0.8); z-index: 100; }\n</style>\n</head>\n<body>\n  <div id=\"sidebar\">\n    <button class=\"btn\" onclick=\"spawnDefender('macrophage')\">Macro (20c)</button>\n    <button class=\"btn\" onclick=\"spawnDefender('neutrophil')\">Neutro (10c)</button>\n    <div id=\"health\">Body Health: 100%</div>\n    <div id=\"cytokines\">Cytokines: 0</div>\n  </div>\n  <div id=\"game-container\"></div>\n  <div id=\"overlay\">\n    <h1 id=\"status-text\">Infection Cleared!</h1>\n    <button class=\"btn\" onclick=\"location.reload()\">Try Again</button>\n  </div>\n  <script>\n    const container = document.getElementById('game-container');\n    const healthEl = document.getElementById('health');\n    const cytoEl = document.getElementById('cytokines');\n    let health = 100; let cytokines = 50; let invaders = []; let defenders = [];\n    function spawnInvader() {\n      const inv = document.createElement('div');\n      inv.className = 'cell bacteria';\n      inv.x = Math.random() < 0.5 ? 0 : 800; inv.y = Math.random() * 600;\n      container.appendChild(inv); invaders.push(inv);\n    }\n    function spawnDefender(type) {\n      let cost = type === 'macrophage' ? 20 : 10;\n      if (cytokines < cost) return;\n      cytokines -= cost; updateUI();\n      const def = document.createElement('div');\n      def.className = 'cell ' + type; def.type = type;\n      def.x = 400; def.y = 300;\n      container.appendChild(def); defenders.push(def);\n    }\n    function updateUI() { healthEl.innerText = `Health: ${health}%`; cytoEl.innerText = `Cytokines: ${cytokines}`; }\n    function loop() {\n      if (Math.random() < 0.05) spawnInvader();\n      invaders.forEach((inv, i) => {\n        inv.x += (400 - inv.x) * 0.005; inv.y += (300 - inv.y) * 0.005;\n        inv.style.left = inv.x + 'px'; inv.style.top = inv.y + 'px';\n        if (Math.abs(inv.x - 400) < 10 && Math.abs(inv.y - 300) < 10) {\n          health -= 1; updateUI(); inv.remove(); invaders.splice(i, 1);\n        }\n      });\n      defenders.forEach((def, i) => {\n        let target = invaders[0];\n        if (target) {\n          def.x += (target.x - def.x) * 0.02; def.y += (target.y - def.y) * 0.02;\n          if (Math.abs(def.x - target.x) < 20 && Math.abs(def.y - target.y) < 20) {\n            target.remove(); invaders.shift(); cytokines += 5; updateUI();\n            if (def.type === 'neutrophil') { def.remove(); defenders.splice(i, 1); }\n          }\n        } else { def.x += (400 - def.x) * 0.01; def.y += (300 - def.y) * 0.01; }\n        def.style.left = def.x + 'px'; def.style.top = def.y + 'px';\n      });\n      if (health <= 0) { document.getElementById('overlay').style.display = 'flex'; document.getElementById('status-text').innerText = 'Body Overwhelmed'; }\n      requestAnimationFrame(loop);\n    }\n    loop();\n  </script>\n</body>\n</html>"
  },
  {
    "title": "Prime Number Spirals",
    "url": "https://www.youtube.com/watch?v=EK32jo7i5LQ",
    "spec": "Build an interactive Ulam Spiral visualizer.\n\nSPECIFICATIONS:\n1. The app should display a grid of numbers in a spiral starting from 1 (the center).\n2. Prime numbers should be clearly highlighted (e.g., as green dots or colored squares).\n3. Allow the user to adjust the 'Granularity' (size of the spiral, e.g., from 100 to 10,000 numbers).\n4. Include a 'Scale' slider to zoom in and out of the visualization.\n5. Allow toggling between a square grid and a hexagonal/circular arrangement if possible (optional but high polish).\n6. Display live stats: Total numbers rendered, Total primes found, and the Density of primes.\n7. When clicking a dot, show the number's value and its prime factors.",
    "code": "<!DOCTYPE html>\n<html>\n<head>\n<style>\n  body { margin: 0; background: #000; color: #00ff00; font-family: monospace; display: flex; flex-direction: column; align-items: center; height: 100vh; }\n  canvas { border: 1px solid #333; margin: 20px; }\n  .controls { padding: 10px; background: #111; display: flex; gap: 20px; }\n  label { font-size: 0.8rem; }\n</style>\n</head>\n<body>\n  <div class=\"controls\">\n    <label>Limit: <input type=\"range\" id=\"limit\" min=\"500\" max=\"20000\" value=\"5000\"></label>\n    <label>Zoom: <input type=\"range\" id=\"zoom\" min=\"1\" max=\"20\" value=\"4\"></label>\n    <div id=\"stats\">Primes: 0</div>\n  </div>\n  <canvas id=\"spiralCanvas\"></canvas>\n  <script>\n    const canvas = document.getElementById('spiralCanvas');\n    const ctx = canvas.getContext('2d');\n    const limitInput = document.getElementById('limit');\n    const zoomInput = document.getElementById('zoom');\n    const statsEl = document.getElementById('stats');\n    \n    function isPrime(n) {\n      if (n < 2) return false;\n      for (let i = 2; i <= Math.sqrt(n); i++) {\n        if (n % i === 0) return false;\n      }\n      return true;\n    }\n\n    function draw() {\n      const limit = parseInt(limitInput.value);\n      const zoom = parseInt(zoomInput.value);\n      canvas.width = window.innerWidth * 0.8; canvas.height = window.innerHeight * 0.8;\n      ctx.fillStyle = 'black'; ctx.fillRect(0, 0, canvas.width, canvas.height);\n      \n      let x = canvas.width/2; let y = canvas.height/2;\n      let step = 1; let stepCount = 0; let direction = 0; // 0=right, 1=up, 2=left, 3=down\n      let primesCount = 0;\n\n      for (let i = 1; i <= limit; i++) {\n        if (isPrime(i)) {\n          primesCount++;\n          ctx.fillStyle = '#0f0';\n          ctx.fillRect(x, y, zoom, zoom);\n        }\n        \n        switch(direction) {\n          case 0: x += zoom; break;\n          case 1: y -= zoom; break;\n          case 2: x -= zoom; break;\n          case 3: y += zoom; break;\n        }\n        \n        stepCount++;\n        if (stepCount === step) {\n          direction = (direction + 1) % 4;\n          if (direction % 2 === 0) step++;\n          stepCount = 0;\n        }\n      }\n      statsEl.innerText = `Primes: ${primesCount} (Density: ${(primesCount/limit*100).toFixed(1)}%)`;\n    }\n    \n    limitInput.oninput = draw; zoomInput.oninput = draw; window.onresize = draw;\n    draw();\n  </script>\n</body>\n</html>"
  },
  {
    "title": "The Silk Road trade simulation",
    "url": "https://www.youtube.com/watch?v=vfe-eNq-Qyg",
    "spec": "Build an interactive Silk Road map and trade manager.\n\nSPECIFICATIONS:\n1. Show an illustrated map of Eurasia with major Silk Road cities (Chang'an, Samarkand, Kashgar, Baghdad, Constantinople).\n2. The user manages a 'Merchant Caravan' with limited resources (Water, Silk, Horses).\n3. Users can move between cities. Moving costs Water and time. Each city has different market prices for Silk and Horses.\n4. Educational pop-ups should appear when reaching a city, explaining its historical significance and the cultural exchange that happened there.\n5. Random events: 'Sandstorm' (lose water), 'Discovery' (extra gold), or 'Bandits' (lose silk).\n6. The goal is to reach Constantinople with the most amount of Gold.\n7. Use historical names and context for goods and locations.",
    "code": "<!DOCTYPE html>\n<html>\n<head>\n<style>\n  body { font-family: 'Georgia', serif; background: #fdf5e6; margin: 0; color: #4a3721; }\n  #game { display: grid; grid-template-columns: 2fr 1fr; height: 100vh; }\n  #map { position: relative; background: #e0d0b0; border-right: 2px solid #8b4513; }\n  .city { position: absolute; width: 20px; height: 20px; background: #8b4513; border-radius: 50%; cursor: pointer; transform: translate(-50%, -50%); }\n  .city:hover { background: #d2691e; }\n  .city::after { content: attr(data-name); position: absolute; top: 25px; left: 50%; transform: translateX(-50%); font-weight: bold; white-space: nowrap; }\n  #stats { padding: 20px; background: #f5deb3; }\n  #log { height: 300px; overflow-y: auto; background: white; padding: 10px; border: 1px solid #8b4513; border-radius: 5px; font-size: 0.9rem; }\n</style>\n</head>\n<body>\n  <div id=\"game\">\n    <div id=\"map\">\n      <div class=\"city\" style=\"left: 80%; top: 60%;\" data-name=\"Chang'an\" onclick=\"visit('Chang\\'an')\"></div>\n      <div class=\"city\" style=\"left: 55%; top: 50%;\" data-name=\"Samarkand\" onclick=\"visit('Samarkand')\"></div>\n      <div class=\"city\" style=\"left: 30%; top: 40%;\" data-name=\"Baghdad\" onclick=\"visit('Baghdad')\"></div>\n      <div class=\"city\" style=\"left: 10%; top: 35%;\" data-name=\"Constantinople\" onclick=\"visit('Constantinople')\"></div>\n    </div>\n    <div id=\"stats\">\n      <h2>Caravan Stats</h2>\n      <div id=\"res\">Gold: 100 | Silk: 5 | Water: 10</div>\n      <hr>\n      <h3>Journal</h3>\n      <div id=\"log\">Welcome to the Silk Road. Begin your journey in Chang'an.</div>\n      <div id=\"actions\" style=\"margin-top: 20px;\"></div>\n    </div>\n  </div>\n  <script>\n    let gold = 100, silk = 5, water = 10; let currentCity = \"Chang'an\";\n    const log = document.getElementById('log');\n    const res = document.getElementById('res');\n    function update() { res.innerText = `Gold: ${gold} | Silk: ${silk} | Water: ${water}`; }\n    function addLog(msg) { const d = document.createElement('div'); d.innerText = msg; log.prepend(d); }\n    function visit(city) {\n      if (city === currentCity) return;\n      if (water < 2) { addLog(\"Not enough water to travel!\"); return; }\n      water -= 2; currentCity = city;\n      addLog(`Traveled to ${city}. The desert was harsh.`);\n      if (Math.random() < 0.3) { addLog(\"A sandstorm hit! Lost 1 unit of water.\"); water--; }\n      if (city === 'Samarkand') {\n        addLog(\"Historical Context: Samarkand was the middle point, a hub for culture and geometry.\");\n        gold += 50; silk -= 2; addLog(\"Sold some silk for gold!\");\n      }\n      if (city === 'Constantinople') {\n        addLog(\"VICTORY! You reached the edge of Europe. Your silk is worth a fortune.\");\n        gold += silk * 40; silk = 0;\n      }\n      update();\n    }\n    update();\n  </script>\n</body>\n</html>"
  },
  {
    "title": "How Light Reflects Off Mirrors",
    "url": "https://www.youtube.com/watch?v=S08_f8U4kOE",
    "spec": "Build a physics-based mirror reflection playground.\n\nSPECIFICATIONS:\n1. A dark 'Optical Bench' area where the user can place a 'Laser Source'.\n2. Allow placing several 'Plane Mirrors' that can be rotated and moved.\n3. The laser should emit a ray that reflects perfectly off the mirrors according to the law of reflection (Angle of Incidence = Angle of Reflection).\n4. Highlight the 'Normal' line at the contact point and display the angles in degrees.\n5. Include 'Concave' and 'Convex' mirror options that converge or diverge light rays correctly.\n6. Add a 'Focal Point' indicator for curved mirrors.\n7. The user should be able to drag mirrors to see how the image positioning changes in real-time.",
    "code": "<!DOCTYPE html>\n<html>\n<head>\n<style>\n  body { margin: 0; background: #111; color: #fff; font-family: sans-serif; overflow: hidden; }\n  canvas { display: block; background: #000; }\n  #ui { position: absolute; top: 10px; left: 10px; background: rgba(50,50,50,0.8); padding: 15px; border-radius: 8px; pointer-events: none; }\n  .instr { font-size: 0.8rem; opacity: 0.8; }\n</style>\n</head>\n<body>\n  <div id=\"ui\">\n    <h3>Optics Playground</h3>\n    <p class=\"instr\">Move mouse to point laser. Mirror is fixed for demo.</p>\n    <div id=\"info\">Angle: 0°</div>\n  </div>\n  <canvas id=\"bench\"></canvas>\n  <script>\n    const canvas = document.getElementById('bench');\n    const ctx = canvas.getContext('2d');\n    const info = document.getElementById('info');\n    \n    let mouseX = 0, mouseY = 0;\n    window.onmousemove = (e) => { mouseX = e.clientX; mouseY = e.clientY; };\n\n    const mirror = { x1: 400, y1: 100, x2: 400, y2: 400 };\n    \n    function draw() {\n      canvas.width = window.innerWidth; canvas.height = window.innerHeight;\n      ctx.clearRect(0, 0, canvas.width, canvas.height);\n      \n      // Draw Mirror\n      ctx.strokeStyle = '#fff'; ctx.lineWidth = 5; ctx.beginPath();\n      ctx.moveTo(mirror.x1, mirror.y1); ctx.lineTo(mirror.x2, mirror.y2); ctx.stroke();\n      \n      // Laser source at (100, 250)\n      const sx = 100, sy = 250;\n      ctx.strokeStyle = 'red'; ctx.lineWidth = 2;\n      \n      // Ray cast from source to mouse/mirror\n      ctx.beginPath(); ctx.moveTo(sx, sy);\n      \n      // Simplified collision with vertical mirror at x=400\n      if (mouseX > 400) {\n        ctx.lineTo(400, sy + (400-sx)*((mouseY-sy)/(mouseX-sx)));\n        const hitY = sy + (400-sx)*((mouseY-sy)/(mouseX-sx));\n        // Reflect\n        ctx.moveTo(400, hitY);\n        const dy = mouseY - sy; const dx = mouseX - sx;\n        ctx.lineTo(400 - (mouseX-400), hitY + dy);\n      } else {\n        ctx.lineTo(mouseX, mouseY);\n      }\n      ctx.stroke();\n      \n      requestAnimationFrame(draw);\n    }\n    draw();\n  </script>\n</body>\n</html>"
  }
